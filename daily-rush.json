// Simple pseudo-random generator date-er seed bebohar kore
function seededRandom(seed) {
    let x = Math.sin(seed++) * 10000;
    return x - Math.floor(x);
}

// Seeded shuffle function
function shuffleArray(array, seed) {
    let shuffled = [...array];
    let currentSeed = seed;
    for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(seededRandom(currentSeed++) * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }
    return shuffled;
}

// Daily JSON generate korar function (25 levels)
function generateDailyRush() {
    const today = new Date().toISOString().split('T')[0];
    
    // Convert today's date string into a numeric seed
    const seed = today.split('-').join('');
    
    // Protidi randomized nuton sequence er jonno shuffle
    const easyWords = shuffleArray(wordBank.easy, Number(seed) + 1);
    const mediumWords = shuffleArray(wordBank.medium, Number(seed) + 2);
    const hardWords = shuffleArray(wordBank.hard, Number(seed) + 3);

    const rounds = [];
    let roundIndex = 1;

    // Easy levels (1 - 10)
    for (let i = 0; i < 10; i++) {
        const item = easyWords[i % easyWords.length];
        rounds.push({
            round: roundIndex++,
            difficulty: "easy",
            word1: item.word1,
            word2: item.word2,
            answer: item.answer
        });
    }

    // Medium levels (11 - 18)
    for (let i = 0; i < 8; i++) {
        const item = mediumWords[i % mediumWords.length];
        rounds.push({
            round: roundIndex++,
            difficulty: "medium",
            word1: item.word1,
            word2: item.word2,
            answer: item.answer
        });
    }

    // Hard levels (19 - 25)
    for (let i = 0; i < 7; i++) {
        const item = hardWords[i % hardWords.length];
        rounds.push({
            round: roundIndex++,
            difficulty: "hard",
            word1: item.word1,
            word2: item.word2,
            answer: item.answer
        });
    }

    return {
        [today]: {
            rounds: rounds
        }
    };
}

// Result generate & print
const result = generateDailyRush();
